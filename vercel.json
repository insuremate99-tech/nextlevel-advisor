{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {"source": "/articles/:slug.html", "destination": "https://www.nextlevel-advisor.com/articles/:slug", "permanent": true},
    {"source": "/solutions/:slug.html", "destination": "https://www.nextlevel-advisor.com/solutions/:slug", "permanent": true},
    {"source": "/:page.html", "destination": "https://www.nextlevel-advisor.com/:page", "permanent": true},
    {"source": "/:path*", "has": [{"type": "host", "value": "nextlevel-advisor.com"}], "destination": "https://www.nextlevel-advisor.com/:path*", "permanent": true},
    {"source": "/calculators", "destination": "/calculator", "permanent": true},
    {"source": "/solutions/savings", "destination": "/solutions/tax-optimization", "permanent": true},
    {"source": "/solutions/savings.html", "destination": "/solutions/tax-optimization", "permanent": true}
  ]
}
